# ===== 學生會會帳 =====
# 唯一可以登入後台的 Google 帳號，也是收新信通知的信箱
ADMIN_EMAIL=

# ===== Google 登入（後台）=====
AUTH_SECRET=            # 執行 `npx auth secret` 產生
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== Supabase（資料庫＋附件）=====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== 新信通知（用學生會會帳的 Gmail 寄給自己）=====
GMAIL_USER=             # 通常與 ADMIN_EMAIL 相同
GMAIL_APP_PASSWORD=     # Google 帳戶 → 安全性 → 應用程式密碼
SITE_URL=               # 例如 https://ccsh-mailbox.vercel.app，通知信會附後台連結

# ===== 人機驗證（選填，建議上線時開啟）=====
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
